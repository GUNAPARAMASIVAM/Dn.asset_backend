datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Lead {
  id             Int    @id @default(autoincrement())
  lead_reference String @unique

  name  String
  phone String
  email String

  main_service  String
  property_type String?
  budget        String?
  location      String?
  purpose       String?

  sell_property_type String?
  expected_price     String?
  sell_service       String?

  lease_type     String?
  lease_duration String?

  management_service String?
  nri_service        String?
  document_service   String?

  contact_method   String?
  appointment_date DateTime?
  appointment_time String?

  lead_status String  @default("New")
  notes       String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  valuations PropertyValuation[]

  @@map("leads")
}

model PropertyValuation {
  id                  Int    @id @default(autoincrement())
  valuation_reference String @unique
  lead_id             Int?
  lead                Lead?  @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  property_type String
  location      String
  locality      String?
  address       String?
  landmark      String?
  pincode       String?

  property_size  String?
  built_up_area  Float?
  area_unit      String?
  land_area      Float?
  land_area_unit String?

  bedrooms     String?
  property_age String?
  floor        String?
  total_floors String?
  condition    String?
  parking      String?
  facing       String?
  road_width   String?

  amenities         String?
  location_features String?

  uploaded_documents String?
  uploaded_images    String?

  estimated_low            BigInt?
  estimated_high           BigInt?
  estimated_midpoint       BigInt?
  estimated_price_per_sqft Float?
  confidence_level         String?
  ai_analysis              String?
  ai_provider              String?

  valuation_status String @default("Pending")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("property_valuations")
}
